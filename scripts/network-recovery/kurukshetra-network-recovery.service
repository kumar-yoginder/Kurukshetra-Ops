# Managed by Kurukshetra-Ops network-recovery v1
[Unit]
Description=Ethernet preferred emergency Wi-Fi SSH recovery
After=network.target systemd-networkd.service
Wants=systemd-networkd.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/sbin/kurukshetra-network-recovery --monitor
ExecStopPost=/usr/local/sbin/kurukshetra-network-recovery --restore
Restart=on-failure
RestartSec=20
TimeoutStopSec=180
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
