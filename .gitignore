# Sensitive files and credentials
.env
.env.local
.env.*.local

# Private keys and certificates
certs/*.key
certs/*.csr
certs/*.srl
certs/*.crt

# Runtime data - do not version control
data/es_data/

# Logs
logs/*
!logs/nginx/.gitkeep
!logs/pihole/.gitkeep

# Docker & system
.DS_Store
.vscode/
*.swp
*.swo
*~
.idea/

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Local Pi-hole configuration and migration backups
data/pihole/
/backups/*
!/backups/.gitkeep

.env.network-tmp

# Generated gateway certificates and local recovery copies
/certs/
/docker-compose.yml.before-*

# Private host-hardening settings and site firewall rules
/config/host-hardening/local.env
/config/host-hardening/lan-hardening.nft
/hardening-audit*.txt

# Tor gateway peer secrets, exports and runtime state
/config/tor-gateway/wg0.conf
/config/tor-gateway/private/
/config/tor-gateway/clients/

# Private Ethernet/Wi-Fi recovery settings
/config/network-recovery/recovery.json

# Implementation plans remain local
/docs/plans/
**/*-PLAN.md

# Generated public status snapshot
/config/nginx/www/status.json
/config/nginx/www/.status-*

/config/nginx/www/tor-metrics.json
/config/nginx/www/.tor-*
/config/nginx/www/client/

# Generated anonymous DNS activity snapshot
/config/nginx/www/dns-activity.json
/config/nginx/www/.dns-*

# Private router session and observation history
/config/router-inventory/local.json
/config/router-inventory/session-token
/data/router-inventory/

/config/router-inventory/session.json
/.venv-router/

/config/router-inventory/secrets/
/config/router-inventory/container.json
/data/dns-activity/

# Central identity secrets and generated runtime configuration
/config/gateway/private/
/data/identity/
/data/gateway-migration/
