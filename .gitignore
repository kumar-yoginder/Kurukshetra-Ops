# Sensitive files and credentials
.env
.env.local
.env.*.local

# Private keys and certificates
certs/*.key
certs/*.csr
certs/*.srl
certs/*.crt

# Runtime data - do not version control
data/es_data/*
!data/es_data/.gitkeep

# Logs
logs/*
!logs/nginx/.gitkeep
!logs/pihole/.gitkeep

# Docker & system
.DS_Store
.vscode/
*.swp
*.swo
*~
.idea/

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Local Pi-hole configuration and migration backups
data/pihole/
backups/

.env.network-tmp
