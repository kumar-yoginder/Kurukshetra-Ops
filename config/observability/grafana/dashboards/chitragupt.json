{
  "uid": "chitragupt",
  "title": "Chitragupt · Runtime and registry",
  "description": "Aggregate-only observation of the existing bot. No user IDs, names, chat titles, messages or tokens. Registry counts are not online membership. Telegram heartbeat, request latency and distributed traces are not instrumented.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "Kurukshetra",
    "metrics-only"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Bot container running",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kurukshetra_service_running{service=\"chitragupt\"}",
          "legendFormat": "Container",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
