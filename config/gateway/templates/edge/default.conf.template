# HTTPS is the only published web listener. No HTTP listener is configured.
limit_req_zone $binary_remote_addr zone=edge_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=edge_connections:10m;
log_format gateway_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent request_id=$request_id';
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __GATEWAY_HOST__;
    server_tokens off;
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:GatewayTLS:10m;
    ssl_session_timeout 1d;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    resolver 127.0.0.11 valid=10s ipv6=off;
    access_log /dev/stdout gateway_safe;
    error_log /dev/stderr warn;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=edge_requests burst=50 nodelay;
    limit_conn edge_connections 30;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cache-Control "no-store" always;
    if ($request_method = TRACE) { return 405; }
    location / {
        set $waf http://gateway-waf:8080;
        proxy_pass $waf;
        proxy_http_version 1.1;
        proxy_set_header Host __GATEWAY_HOST__;
        proxy_set_header X-Gateway-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host __GATEWAY_HOST__;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header X-Forwarded-User "";
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
        proxy_hide_header Server;
        proxy_cookie_flags ~ secure httponly samesite=lax;
    }
}
