{
  "theme": "dark",
  "server": {
    "address": "tcp://0.0.0.0:9091/auth"
  },
  "log": {
    "level": "warn",
    "format": "json"
  },
  "authentication_backend": {
    "password_reset": {
      "disable": true
    },
    "file": {
      "path": "/config/users.yml",
      "watch": true
    }
  },
  "access_control": {
    "default_policy": "deny",
    "rules": [
      {
        "domain": "__GATEWAY_HOST__",
        "policy": "one_factor"
      }
    ]
  },
  "session": {
    "name": "__Secure-kurukshetra-session",
    "same_site": "lax",
    "inactivity": "30m",
    "expiration": "8h",
    "remember_me": "0",
    "cookies": [
      {
        "domain": "__GATEWAY_HOST__",
        "authelia_url": "https://__GATEWAY_HOST__/auth/",
        "default_redirection_url": "https://__GATEWAY_HOST__/"
      }
    ]
  },
  "storage": {
    "local": {
      "path": "/state/identity.sqlite3"
    }
  },
  "notifier": {
    "filesystem": {
      "filename": "/state/notifications.txt"
    }
  },
  "regulation": {
    "max_retries": 5,
    "find_time": "2m",
    "ban_time": "10m"
  }
}
